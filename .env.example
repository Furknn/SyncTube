# Address the published ports bind to. Use 127.0.0.1 when a local
# reverse proxy (nginx, caddy, `tailscale serve`) sits in front.
BIND_ADDR=0.0.0.0

# --- Voice chat TURN relay (used with `docker compose --profile turn up -d`) ---
# IP that both participants can reach (e.g. the server's Tailscale IP).
TURN_IP=100.64.0.1
TURN_USER=synctube
TURN_PASS=change-me
TURN_URLS=turn:100.64.0.1:3478?transport=udp,turn:100.64.0.1:3478?transport=tcp

# Optional public STUN servers (comma separated), e.g. stun:stun.l.google.com:19302
STUN_URLS=
